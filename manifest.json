{
   "manifest_version": 3,
   "name": "SHINE for reddit (unofficial)",
   "short_name": "SHINE",
   "version": "2.0.0",
   "description": "Experience old reddit with modern list and grid view interfaces that focus on bringing the content to you.",
   "icons": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
   },
   "action": {
      "default_icon": {
         "16": "icon-16.png",
         "48": "icon-48.png",
         "128": "icon-128.png"
      },
      "default_title": "Open old reddit"
   },
   "background": {
      "service_worker": "background.js",
      "scripts": [ "background.js" ]
   },
   "permissions": [ "storage", "scripting", "declarativeNetRequestWithHostAccess" ],
   "host_permissions": [ "*://*.reddit.com/*" ],
   "declarative_net_request": {
      "rule_resources": [ {
         "id": "old_reddit_redirect",
         "enabled": true,
         "path": "rules/old-reddit-redirect.json"
      } ]
   },
   "content_scripts": [ {
      "css": [
         "fonts.css",
         "base.css",
         "shine-grid.css",
         "shine-list.css",
         "shine-list-classic.css",
         "shine-default.css",
         "materialdesignicons.min.css",
         "themes/nightmode.css",
         "themes/theme-violet.css",
         "themes/theme-gray.css",
         "themes/theme-black.css",
         "themes/theme-dark.css",
         "themes/theme-blue.css",
         "themes/theme-brown.css",
         "themes/theme-material.css",
         "themes/theme-modernwhite.css",
         "colors/color-red.css",
         "colors/color-orange.css",
         "colors/color-amber.css",
         "colors/color-lime.css",
         "colors/color-greenlight.css",
         "colors/color-teal.css",
         "colors/color-cyan.css",
         "colors/color-blue.css",
         "colors/color-indigo.css",
         "colors/color-pink.css",
         "colors/color-yellow.css",
         "colors/color-purple.css"
      ],
      "matches": [ "*://old.reddit.com/*" ],
      "run_at": "document_start"
   }, {
      "js": [
         "jquery-3.7.1.min.js",
         "base.js"
      ],
      "matches": [ "*://old.reddit.com/*" ],
      "run_at": "document_end"
   }, {
      "js": [ "shine-detect.js" ],
      "matches": [ "*://*.reddit.com/*" ],
      "exclude_matches": [ "*://old.reddit.com/*" ],
      "run_at": "document_end"
   } ],
   "web_accessible_resources": [ {
      "resources": [ "materialdesignicons-webfont.woff2" ],
      "matches": [ "*://*.reddit.com/*" ]
   } ],
   "browser_specific_settings": {
      "gecko": {
         "id": "shine-unofficial@fork.local",
         "strict_min_version": "128.0"
      }
   }
}
